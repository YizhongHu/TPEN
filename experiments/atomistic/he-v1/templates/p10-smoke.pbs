#!/usr/bin/env bash
# Parameterized P10 Polaris smoke. The launch packet supplies these exports.
#PBS -A HetRxnEnergy
#PBS -q debug
#PBS -k doe
#PBS -V
#PBS -l select=1:system=polaris,walltime=00:50:00,filesystems=home:eagle,place=scatter
#PBS -o /dev/null
#PBS -e /dev/null
set -euo pipefail

: "${TPEN_EXPECTED_HEAD:?expected checkout head is required}"
: "${TPEN_RUN_ROOT:?run root is required}"
: "${TPEN_ENV_ROOT:?environment root is required}"
: "${TPEN_EXPECTED_LOCK_SHA:?expected executor lock SHA is required}"

ROOT="$TPEN_RUN_ROOT"
CHECKOUT="$ROOT/checkout"
ENV_ROOT="$TPEN_ENV_ROOT"
SCI_PY="$ENV_ROOT/tpen-polaris-alcf-2025-09-25/bin/python"
EXEC_PY="$ENV_ROOT/tpen-executor-polaris-20261107/bin/python"
EFFECTIVE="$ROOT/attached/effective-he-train.yaml"
INPUT="$ROOT/attached/executor_input.json"
RUNS="$ROOT/attached/configured-runs.json"
ALLOCATION="$ROOT/allocation.json"
WORKER="$ROOT/worker.yaml"
STORE="$ROOT/store"

# Keep caches, temporary files, and Parsl state below this smoke's run root.
export HOME="$ROOT/home"
export XDG_CACHE_HOME="$ROOT/xdg-cache"
export XDG_CONFIG_HOME="$ROOT/xdg-config"
export XDG_STATE_HOME="$ROOT/xdg-state"
export UV_CACHE_DIR="$ROOT/uv-cache"
export PIP_CACHE_DIR="$ROOT/pip-cache"
export MPLCONFIGDIR="$ROOT/mplconfig"
export TORCH_HOME="$ROOT/torch-cache"
export HF_HOME="$ROOT/hf-cache"
export WANDB_DIR="$ROOT/wandb"
export WANDB_CACHE_DIR="$ROOT/wandb-cache"
export WANDB_CONFIG_DIR="$ROOT/wandb-config"
export TMPDIR="$ROOT/tmp"
export TMP="$TMPDIR"
export TEMP="$TMPDIR"
export PARSL_RUN_DIR="$ROOT/parsl"
export PYTHONNOUSERSITE=1
mkdir -p "$HOME" "$XDG_CACHE_HOME" "$XDG_CONFIG_HOME" "$XDG_STATE_HOME" \
  "$UV_CACHE_DIR" "$PIP_CACHE_DIR" "$MPLCONFIGDIR" "$TORCH_HOME" "$HF_HOME" \
  "$WANDB_DIR" "$WANDB_CACHE_DIR" "$WANDB_CONFIG_DIR" "$TMPDIR" "$PARSL_RUN_DIR" \
  "$ROOT/preflight" "$ROOT/logs"

printf '%s\n' "$(hostname -f)" > "$ROOT/job-hostname.txt"
date -u +%Y-%m-%dT%H:%M:%SZ > "$ROOT/job-start-utc.txt"
printf '%s\n' "$TPEN_EXPECTED_HEAD" > "$ROOT/expected-head.txt"

source "$ROOT/science_setup.sh"
source "$ROOT/control_setup.sh"
export CUDA_VISIBLE_DEVICES=0
export OMP_NUM_THREADS=4

# Identity and cleanliness gates precede the profile preflight.
HEAD=$(git -C "$CHECKOUT" rev-parse HEAD)
test "$HEAD" = "$TPEN_EXPECTED_HEAD"
test -z "$(git -C "$CHECKOUT" status --porcelain)"
LOCK_SHA=$(sha256sum "$CHECKOUT/executor/uv.lock" | awk '{print $1}')
test "$LOCK_SHA" = "$TPEN_EXPECTED_LOCK_SHA"
printf '%s\n' "$HEAD" > "$ROOT/preflight/checkout-head.txt"
printf '%s\n' "$LOCK_SHA" > "$ROOT/preflight/uv-lock.sha256"
printf '%s\n' "$HOME" > "$ROOT/preflight/job-home.txt"

test -x "$SCI_PY"
test -x "$EXEC_PY"
for path in "$EFFECTIVE" "$INPUT" "$RUNS" "$ALLOCATION" "$WORKER"; do test -f "$path"; done

TPEN_CHECKOUT="$CHECKOUT" env PYTHONPATH="$CHECKOUT" "$SCI_PY" - <<'PY' > "$ROOT/preflight/science-import.txt"
import os
from pathlib import Path
import tpen
root = Path(os.environ["TPEN_CHECKOUT"]).resolve()
path = Path(tpen.__file__).resolve()
print(f"tpen.__file__={path}")
assert path.is_relative_to(root), (path, root)
PY

TPEN_CHECKOUT="$CHECKOUT" env -u PYTHONPATH "$EXEC_PY" - <<'PY' > "$ROOT/preflight/executor-import.txt"
import os
from pathlib import Path
import site
import tpen_executor
root = Path(os.environ["TPEN_ENV_ROOT"]).resolve()
path = Path(tpen_executor.__file__).resolve()
site_roots = tuple(Path(item).resolve() for item in site.getsitepackages())
print(f"tpen_executor.__file__={path}")
print(f"site_packages={site_roots}")
assert any(path.is_relative_to(item) for item in site_roots if item.is_relative_to(root)), (path, root, site_roots)
assert not path.is_relative_to(Path(os.environ["TPEN_CHECKOUT"]).resolve()), path
PY

env PYTHONPATH="$CHECKOUT" "$SCI_PY" -m tpen.checkpoint.profiles "$EFFECTIVE" \
  --profile tpen.native-recovery/v1 > "$ROOT/preflight/profile.stdout" 2> "$ROOT/preflight/profile.stderr"
"$SCI_PY" - "$ROOT/preflight/profile.stdout" <<'PY'
import json
import sys
from pathlib import Path
value = json.loads(Path(sys.argv[1]).read_text())
print(value)
assert value.get("verdict") == "supported", value
PY

set +e
env -u PYTHONPATH "$EXEC_PY" -m tpen_executor dispatch \
  --input "$INPUT" --runs "$RUNS" --allocation "$ALLOCATION" \
  --worker-config "$WORKER" --store "$STORE" --dispatcher parsl --timeout 1200 \
  > "$ROOT/logs/executor.stdout" 2> "$ROOT/logs/executor.stderr"
EXEC_RC=$?
set -e
printf '%s\n' "$EXEC_RC" > "$ROOT/logs/executor.returncode"
test "$EXEC_RC" -eq 0
test -s "$STORE/run-manifest.json"

env PYTHONPATH="$CHECKOUT" "$SCI_PY" - "$STORE/run-manifest.json" \
  > "$ROOT/logs/p8-reader.stdout" 2> "$ROOT/logs/p8-reader.stderr" <<'PY'
import json
import sys
from experiments.toolkit.run_results import read
result = read(sys.argv[1])
assert len(result.chains) == 1, result
assert len(result.chains[0].segments) == 1, result
segment = result.chains[0].segments[0]
assert segment.next_iteration == 25, segment
assert segment.completed_updates == 25, segment
print(json.dumps({"chains": len(result.chains), "segments": len(result.chains[0].segments), "task_id": result.chains[0].task_id, "next_iteration": segment.next_iteration, "completed_updates": segment.completed_updates}, sort_keys=True))
PY

# Ask the installed executor package for its single product-owned filename.
CHILD_OBSERVATION_FILENAME=$(env -u PYTHONPATH "$EXEC_PY" -c 'from tpen_executor.runners import CHILD_OBSERVATION_FILENAME; print(CHILD_OBSERVATION_FILENAME)')
env PYTHONPATH="$CHECKOUT" "$SCI_PY" - "$STORE/run-manifest.json" "$ROOT/terminal-summary.json" "$CHILD_OBSERVATION_FILENAME" <<'PY'
import json
import os
import sys
from pathlib import Path
import yaml

manifest_path, summary_path, child_observation_filename = map(Path, sys.argv[1:])
manifest = json.loads(manifest_path.read_text())
assert manifest["schema"] == "tpen-executor/run-manifest-v2", manifest
assert len(manifest["attempts"]) == 1, manifest
assert len(manifest["segments"]) == 1, manifest
attempt = manifest["attempts"][0]
receipt = attempt["placement_receipt"]
attempt_root = Path(attempt["output_dir"])
observation = json.loads((attempt_root / child_observation_filename).read_text())
resolved = yaml.safe_load((attempt_root / "resolved_config.yaml").read_text())
segment = manifest["segments"][0]
checkpoint = Path(segment["checkpoint_dir"])
assert (checkpoint / "COMPLETE").is_file(), checkpoint
assert resolved["trainer"]["max_steps"] == 25, resolved
assert resolved["sampler"]["n_walkers"] == 16, resolved
assert observation["cuda_visible_devices"] == "0", observation
assert observation["environment"]["OMP_NUM_THREADS"] == "4", observation
eagle_checkpoint = str(checkpoint)
lus_checkpoint = eagle_checkpoint.replace("/eagle/", "/lus/eagle/", 1)
fence_pass = os.path.realpath(eagle_checkpoint) == os.path.realpath(lus_checkpoint)
assert fence_pass, (eagle_checkpoint, lus_checkpoint, os.path.realpath(eagle_checkpoint), os.path.realpath(lus_checkpoint))
summary = {
    "manifest": str(manifest_path),
    "manifest_schema": manifest["schema"],
    "accepted_segment": {"task_id": segment["task_id"], "completed_updates": segment["completed_updates"], "next_iteration": segment["next_iteration"], "checkpoint_dir": segment["checkpoint_dir"]},
    "attempt_status": attempt["outcome_receipt"]["status"],
    "checkpoint_complete": str(checkpoint / "COMPLETE"),
    "child_observation": str(attempt_root / child_observation_filename),
    "child_hostname": observation["hostname"],
    "child_cuda_visible_devices": observation["cuda_visible_devices"],
    "child_omp_num_threads": observation["environment"]["OMP_NUM_THREADS"],
    "resolved_trainer_max_steps": resolved["trainer"]["max_steps"],
    "resolved_sampler_n_walkers": resolved["sampler"]["n_walkers"],
    "placement_receipt": {"comparison": receipt["comparison"], "declared": receipt["declared"], "observed": {"host": receipt["child"]["host"], "cuda_visible_devices": receipt["child"]["cuda_visible_devices"], "affinity": receipt["child"]["affinity"]}, "refusal": receipt.get("refusal"), "gpu_status": receipt["gpu"]["status"]},
    "fence": {"outcome": "PASS", "eagle_path": eagle_checkpoint, "lus_path": lus_checkpoint, "eagle_realpath": os.path.realpath(eagle_checkpoint), "lus_realpath": os.path.realpath(lus_checkpoint)},
    "home": os.environ["HOME"],
}
summary_path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")
print(json.dumps(summary, sort_keys=True))
PY

date -u +%Y-%m-%dT%H:%M:%SZ > "$ROOT/job-finish-utc.txt"
