#!/usr/bin/env bash
#PBS -N tpen-polaris-gpu-qualify
#PBS -S /bin/bash
set -euo pipefail
: "${RUN_ENV_PATH:?RUN_ENV_PATH is required}"
test -f "$RUN_ENV_PATH"
source "$RUN_ENV_PATH"
export CUDA_VISIBLE_DEVICES=0
export PYTHONDONTWRITEBYTECODE=1
test "$("$RUN_PYTHON" -m uv --version)" = "uv $RUN_UV_EXPECTED"
JOB_ROOT="/local/scratch/$PBS_JOBID"
JOB_ENV="$JOB_ROOT/tpen-gpu-env"
JOB_EVIDENCE="$RUN_EVIDENCE_DIR/$PBS_JOBID"
mkdir -p "$JOB_ROOT" "$JOB_EVIDENCE"
export JOB_ENV
export UV_CACHE_DIR="$RUN_CACHE_DIR"
export UV_PROJECT_ENVIRONMENT="$JOB_ENV"
export UV_LINK_MODE=copy
"$RUN_PYTHON" -m uv sync --offline --extra "$RUN_EXTRA" --locked --project "$RUN_PROJECT" > "$JOB_EVIDENCE/uv-sync.stdout" 2> "$JOB_EVIDENCE/uv-sync.stderr"
test "$("$RUN_PYTHON" -m uv --version)" = "uv $RUN_UV_EXPECTED"
exec "$JOB_ENV/bin/python" "$RUN_JOB_PY" "$RUN_ENV_PATH"
