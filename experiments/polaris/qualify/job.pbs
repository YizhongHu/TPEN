#!/usr/bin/env bash
#PBS -N tpen-polaris-gpu-qualify
#PBS -S /bin/bash
set -euo pipefail
: "${RUN_ENV_PATH:?RUN_ENV_PATH is required}"
test -f "$RUN_ENV_PATH"
source "$RUN_ENV_PATH"
export CUDA_VISIBLE_DEVICES=0
export PYTHONDONTWRITEBYTECODE=1
JOB_ROOT="/local/scratch/$PBS_JOBID"
JOB_ENV="$JOB_ROOT/tpen-gpu-env"
export JOB_ENV
exec "$RUN_PYTHON" "$RUN_JOB_PY" "$RUN_ENV_PATH"
