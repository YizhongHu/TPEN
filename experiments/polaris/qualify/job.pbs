#!/usr/bin/env bash
#PBS -N tpen-polaris-gpu-qualify
#PBS -S /bin/bash
set -euo pipefail
: "${RUN_ENV_PATH:?RUN_ENV_PATH is required}"
test -f "$RUN_ENV_PATH"
source "$RUN_ENV_PATH"
export LD_LIBRARY_PATH="$RUN_LIBSHIM:$RUN_CUDA13_LIB:$RUN_CUDA129_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export CUDA_VISIBLE_DEVICES=0
export PYTHONDONTWRITEBYTECODE=1
exec "$RUN_PYTHON" "$RUN_JOB_PY" "$RUN_ENV_PATH"
