#!/usr/bin/env bash
# Stored job script. All run-specific values come from RUN_ENV_PATH.
#PBS -N tpen-polaris-verify
#PBS -S /bin/bash
set -euo pipefail
: "${RUN_ENV_PATH:?RUN_ENV_PATH is required}"
test -f "$RUN_ENV_PATH"
source "$RUN_ENV_PATH"
exec "$RUN_PYTHON" "$(dirname "$0")/job.py" "$RUN_ENV_PATH"
